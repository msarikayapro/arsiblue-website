APP_NAME="Arsi Blue Beach"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://arsibluebeach.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public_uploads
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Admin'e yeni lead bildirimleri için
ADMIN_NOTIFICATION_EMAIL=

# İlk seeder admin şifresi (kurulum sonrası değiştirin)
ADMIN_INITIAL_PASSWORD=

# Migration tetikleme rotası: /admin/system-update-{SECRET}
SYSTEM_UPDATE_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Tracking değerleri admin panelinden settings tablosuna kaydedilir, .env'de değil:
# Meta Pixel ID, Meta CAPI Token, GTM ID, GA4 ID, Google Ads, TikTok Pixel
